# Local Development Environment Variables
# ----------------------------------------
# Copy this file to .env and fill in your values

# PostgreSQL Database (Supabase)
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"

# JWT Auth Secret (generate a random 64-char string)
JWT_SECRET="your-super-secret-jwt-key-replace-this-in-production"
JWT_EXPIRES_IN="7d"

# Server
PORT=5000
NODE_ENV=development

# CORS - Allowed Origins (comma separated)
CORS_ORIGINS="http://localhost:3000,http://localhost:5173"
